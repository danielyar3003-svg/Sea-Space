# Copy to backend/.env for local development. Never commit the real .env.
APP_ENV=development
LOG_LEVEL=INFO

# PostgreSQL. In production use an ordinary role (NOT superuser / BYPASSRLS),
# otherwise row-level security is bypassed.
DATABASE_URL=postgresql+psycopg://seaspace:seaspace@localhost:5432/seaspace
TEST_DATABASE_URL=postgresql+psycopg://seaspace:seaspace@localhost:5432/seaspace_test

# Comma-separated origins allowed to call the API from a browser (Flutter web / admin).
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# --- Supabase Auth (required) -------------------------------------------------
# Project URL: Supabase dashboard → Project Settings → API.
SUPABASE_URL=
# Optional: legacy HS256 JWT secret. Leave empty to verify tokens via the project JWKS.
SUPABASE_JWT_SECRET=

# --- Encryption of stored OAuth tokens (required before Gmail is connected) ---
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# --- Later phases -------------------------------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_PUBSUB_TOPIC=
